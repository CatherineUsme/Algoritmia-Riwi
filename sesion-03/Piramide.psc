Algoritmo Piramide
	definir i, fila, n, j Como Entero
	escribir "Altura de la priamide: "
	leer n
	Para fila <-1 Hasta n Hacer
		Para i <-1 Hasta n-fila con paso 1 Hacer
			escribir Sin Saltar " "
		Fin Para
		Para j<-1 Hasta 2*fila-1 Hacer
			escribir sin saltar "*"
		Fin Para
		Escribir ""
	Fin Para
FinAlgoritmo
